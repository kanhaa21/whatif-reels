 "phrases": [
  {
   "text": "One wrong step,",
   "s": 0.03,
   "seg": 0,
   "e": 1.06
  },
  {
   "text": "and the ground grabs your legs.",
   "s": 1.06,
   "seg": 0,
   "e": 2.95
  },
  {
   "text": "You're on a riverbank,",
   "s": 3.12,
   "seg": 1,
   "e": 4.25
  },
  {
   "text": "alone,",
   "s": 4.61,
   "seg": 2,
   "e": 5.16
  },
  {
   "text": "and the sand is turning to soup.",
   "s": 5.52,
   "seg": 3,
   "e": 7.46
  },
  {
   "text": "You panic and pull.",
   "s": 7.61,
   "seg": 4,
   "e": 8.93
  },
  {
   "text": "Your foot won't budge.",
   "s": 9.32,
   "seg": 5,
   "e": 10.54
  },
  {
   "text": "Pull harder?",
   "s": 10.72,
   "seg": 6,
   "e": 11.69
  },
  {
   "text": "You'd need the strength to lift a car.",
   "s": 12.03,
   "seg": 7,
   "e": 14.07
  },
  {
   "text": "Every kick sinks you deeper.",
   "s": 14.24,
   "seg": 8,
   "e": 16.31
  },
  {
   "text": "The movies say you vanish.",
   "s": 16.77,
   "seg": 9,
   "e": 18.61
  },
  {
   "text": "But here's the secret:",
   "s": 18.86,
   "seg": 10,
   "e": 19.95
  },
  {
   "text": "quicksand is about twice as dense as your body.",
   "s": 20.43,
   "seg": 11,
   "e": 23.34
  },
  {
   "text": "You can only sink to about your waist.",
   "s": 23.53,
   "seg": 12,
   "e": 25.94
  },
  {
   "text": "So stop pulling.",
   "s": 25.94,
   "seg": 12,
   "e": 27.16
  },
  {
   "text": "Wiggle your legs slowly,",
   "s": 27.48,
   "seg": 13,
   "e": 28.79
  },
  {
   "text": "lean back,",
   "s": 29.16,
   "seg": 14,
   "e": 29.96
  },
  {
   "text": "and float out.",
   "s": 29.96,
   "seg": 14,
   "e": 30.99
  },
  {
   "text": "Quicksand can't swallow you.",
   "s": 31.22,
   "seg": 15,
   "e": 34.09
  },
  {
   "text": "Panic can.",
   "s": 34.45,
   "seg": 16,
   "e": 36.06
  }
 ],
 "frames": 1093
